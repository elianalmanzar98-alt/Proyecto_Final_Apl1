@page "/login"
@using GoldCrew.Services
@using GoldCrew.Web.Security
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject CustomAuthStateProvider Auth
@inject NavigationManager Nav

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">RegistroInventario: Inicio de sesión</h5></div>
            <div class="card-body">
                <EditForm Model="modelo" OnValidSubmit="Entrar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <InputText class="form-control" @bind-Value="modelo.Usuario" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="modelo.Clave" />
                    </div>
                    <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                </EditForm>
                @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger mt-3">@error</div> }
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel modelo = new();
    private string? error;

    private async Task Entrar()
    {
        var s = await AuthService.LoginAsync(modelo.Usuario, modelo.Clave);
        if (s is null)
        {
            error = "Inicio de sesion incorrecto. Por favor verifique su usuario y contraseña.";
            return;
        }
        await Auth.IniciarSesionAsync(s);
        Nav.NavigateTo("/");
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Error en el inicio de sesion: el campo 'Usuario' es obligatorio")]
        public string Usuario { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "error en el inicio de sesion: el campo 'Contraseña' es obligatorio")]
        public string Clave { get; set; } = "";
    }
}