<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeView>
            <Authorized Context="authState">
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            </Authorized>
            <NotAuthorized Context="authState">
                @if (routeData.PageType == typeof(RegistroInventario.Components.Pages.Login))
                {
                    <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing><p>Cargando...</p></Authorizing>
        </AuthorizeView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)"><p>Página no encontrada.</p></LayoutView>
    </NotFound>
</Router>