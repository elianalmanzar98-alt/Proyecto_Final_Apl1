@using GoldCrew.Web.Security
@inherits LayoutComponentBase
@inject CustomAuthStateProvider Auth
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <nav>
            <strong>GoldCrew</strong> |
            <NavLink href="" Match="NavLinkMatch.All">Inicio</NavLink> |
            <NavLink href="categorias">Categorías</NavLink> |
            <NavLink href="reportes/categorias">Reporte de categorías</NavLink> |
            Usuario: @context.User.Identity?.Name (@context.User.FindFirst(ClaimTypes.Role)?.Value) |
            <button @onclick="CerrarSesion">Cerrar sesión</button>
        </nav>
        <hr />
    </Authorized>
</AuthorizeView>
<main>@Body</main>

@code {
    private async Task CerrarSesion()
    {
        await Auth.CerrarSesionAsync();
        Nav.NavigateTo("/login");
    }
}